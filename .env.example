# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP_USERNAME & APP_PASSWORD / APP_PASSWORD_HASH:
# Beveilig de applicatie met een inlogpagina via Docker Compose omgevingsvariabelen.
# Tip: Gebruik APP_PASSWORD_HASH (SHA-256 hex) zodat het wachtwoord niet in platte tekst staat.
APP_USERNAME="admin"
APP_PASSWORD=""
APP_PASSWORD_HASH=""
SESSION_SECRET=""

# MUSIC_LIBRARY_PATH, DATA_PATH & EXPORTS_PATH:
# Paden naar de gemounte volumes in de Docker container
MUSIC_LIBRARY_PATH="/music"
DATA_PATH="/app/data"
EXPORTS_PATH="/exports"

# SPOTIFY_CLIENT_ID & SPOTIFY_CLIENT_SECRET: Spotify Developer application credentials.
# Configure these in the AI Studio Secrets panel or docker-compose.yml.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
